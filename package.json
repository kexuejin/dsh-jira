{
  "name": "dsh-jira",
  "version": "0.1.0",
  "description": "Jira issue tracker for DeepSeek Harness: internal Jira Data Center/Server issue views, agent tools, and safe issue updates.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "docs/plans"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "jira",
    "issue-tracker",
    "jira-data-center"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-connection": "link:../deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../deepseek-harness/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "link:../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-credentials": "link:../deepseek-harness/packages/credentials/credentials",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-util-values": "link:../deepseek-harness/packages/util/values",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "lightningcss": "^1.30.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
